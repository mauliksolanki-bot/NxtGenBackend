# Copy to /opt/nxtgen/backend/shared/backend.env and edit with sudo nano.
# This is a systemd EnvironmentFile: no export commands or shell expansion.
SPRING_PROFILES_ACTIVE=production
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
APP_CORS_ALLOWED_ORIGIN=http://172.198.161.188

PROD_DB_URL="jdbc:mysql://YOUR_DATABASE_HOST:4000/YOUR_DATABASE?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3"
PROD_DB_USERNAME="CHANGE_ME"
PROD_DB_PASSWORD="CHANGE_ME"
# At least 32 bytes. Bootstrap generates this once; keep it stable across releases.
PROD_JWT_SECRET="CHANGE_ME"
